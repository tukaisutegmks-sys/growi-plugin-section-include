{
  "name": "growi-plugin-section-include",
  "version": "0.1.2",
  "description": "Include only a named Markdown section from another GROWI page.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "growi",
    "growi-plugin",
    "markdown",
    "section-include"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "@growi/pluginkit": "^1.1.0",
    "react": "^18.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-directive": "^3.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "packageManager": "pnpm@10.14.0",
  "growiPlugin": {
    "schemaVersion": "4",
    "types": [
      "script"
    ]
  }
